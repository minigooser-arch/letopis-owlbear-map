{
  "name": "Летопись: карта Minecraft",
  "version": "1.0.1",
  "manifest_version": 1,
  "description": "Синхронизация карты Летописи и координат Minecraft в Owlbear Rodeo.",
  "icon": "https://minigooser-arch.github.io/letopis-owlbear-map/icon.svg",
